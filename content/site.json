        "layout": [
          {
            "blockType": "features",
            "heading": "My contributions",
            "items": [
              {
                "title": "MCP access configuration",
                "text": "A dedicated read-only database user with validated credentials, so AI clients can query but never change data."
              },
              {
                "title": "AI client configuration",
                "text": "Generated configs for Claude, Codex, Cursor, Gemini CLI and GitHub Copilot, plus a doctor command to check them."
              },

          "alt": "Exasol Personal Local Starter Kit: one install command, a database ready, MCP read-only login, AI clients connected"
        },
        "heroImage": {
          "url": "https://itfzpetffxsglwfmnghl.supabase.co/storage/v1/object/public/media/media/kit-hero-1.jpg",
          "alt": "Exasol Personal Local Starter Kit: one install command, a database ready, MCP read-only login, AI clients connected"
        },
        "heroVideo": null,

# PostgreSQL connection string.
# Local:    postgres://postgres:password@127.0.0.1:5432/sheetaldharshan
# Supabase: use the *Transaction pooler* string (port 6543) with DATABASE_POOL_MAX=2 on serverless,
#           e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#           (the session pooler on 5432 caps at 15 clients; keep it for one-off migrations)
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/sheetaldharshan
# Force TLS for hosts the config does not recognise automatically
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Long random secret used to sign Payload sessions. Generate: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Secret that protects the draft preview route. Generate: openssl rand -hex 24
PREVIEW_SECRET=replace-with-another-random-secret

# Public origin of the site, no trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Media storage in production (pick one; leave both empty locally to use public/media).
# Option A: Vercel Blob
BLOB_READ_WRITE_TOKEN=
# Option B: Supabase Storage via its S3-compatible endpoint
#   Supabase > Storage > create a public bucket "media"; Project Settings > Storage > S3 access keys
S3_BUCKET=
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<project-region>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Alternative to S3 access keys: S3_ACCESS_KEY_ID=<project-ref>, S3_SECRET_ACCESS_KEY=<anon key>, S3_SESSION_TOKEN=<service role key>
S3_SESSION_TOKEN=
# Public CDN base for the bucket, so images are served directly from Supabase
S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media

# Optional: secret for scheduled jobs (Vercel Cron). Leave empty if unused.
CRON_SECRET=

# Admin sign-in, step two: GitHub through Supabase Auth (see docs/make-it-yours.md, step 7).
# Optional when the S3_* variables above point at the same Supabase project; they are read from there.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Emergency switch: "off" turns the GitHub step off (password only). Leave empty normally.
ADMIN_2FA=

# Optional: search engine ownership verification codes
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Contact page email alerts (resend.com, free up to 3,000 emails a month). Without a key, messages
# are still saved in the admin under Contact page > Messages.
RESEND_API_KEY=
# Optional sender once your own domain is verified in Resend, e.g. "Portfolio <hello@yourdomain.com>".
# Left empty, Resend's shared sender is used, which can only email your own Resend account address.
CONTACT_FROM_EMAIL=

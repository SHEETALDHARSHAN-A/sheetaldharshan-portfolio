# PostgreSQL connection string (managed Postgres in production)
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/sheetaldharshan

# Long random secret used to sign Payload sessions. Generate: openssl rand -hex 32
PAYLOAD_SECRET=replace-with-a-long-random-secret

# Secret that protects the draft preview route. Generate: openssl rand -hex 24
PREVIEW_SECRET=replace-with-another-random-secret

# Public origin of the site, no trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: Vercel Blob token for persistent media uploads in production.
# When unset, uploads are written to public/media (fine locally, not on an ephemeral host).
BLOB_READ_WRITE_TOKEN=

# Optional: secret for scheduled jobs (Vercel Cron). Leave empty if unused.
CRON_SECRET=
